---
// 버튼은 JS가 없으면 동작하지 않으므로 html.js일 때만 보인다(BaseLayout 인라인 스크립트가 붙임).
// 아이콘은 적용 중인 테마를 CSS로 따라가고, aria-pressed는 아래 스크립트가 맞춘다.
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<button type="button" class="theme-toggle" aria-pressed="false">
  <svg
    class="theme-toggle__icon theme-toggle__icon--light"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"></path>
  </svg>
  <svg
    class="theme-toggle__icon theme-toggle__icon--dark"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
  </svg>
  <span class="sr-only">{ui[locale].theme.label}</span>
</button>

<script>
  import { getTheme, onThemeChange, toggleTheme } from '../scripts/theme';

  const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');
  const sync = () => {
    const pressed = String(getTheme() === 'dark');
    buttons.forEach((button) => button.setAttribute('aria-pressed', pressed));
  };

  buttons.forEach((button) => button.addEventListener('click', toggleTheme));
  onThemeChange(sync);
  sync();
</script>

<style>
  .theme-toggle {
    display: none;
    width: 44px;
    height: 44px;
    flex: none;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--color-text-muted);
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  :global(html.js) .theme-toggle {
    display: inline-flex;
  }

  .theme-toggle:hover {
    background: var(--color-surface);
  }

  .theme-toggle__icon {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  /* 적용 중인 테마의 아이콘만 보인다. 우선순위는 tokens.css와 같다(data-theme > 시스템 설정). */
  .theme-toggle__icon--dark,
  :global(:root[data-theme='dark']) .theme-toggle__icon--light {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-toggle__icon--dark {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .theme-toggle__icon--light {
      display: none;
    }

    :global(:root:not([data-theme])) .theme-toggle__icon--dark {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle {
      transition: none;
    }
  }
</style>
