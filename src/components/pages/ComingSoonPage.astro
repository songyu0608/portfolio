---
// 단계 4의 페이지 지시서가 페이지별 컴포넌트로 교체할 준비 페이지.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
  page: 'contact';
}

const { locale, page } = Astro.props;
const text = ui[locale].pages;
const { name, description } = text[page];
---

<BaseLayout locale={locale} title={name} description={description}>
  <div class="coming-soon container">
    <h1>{name}</h1>
    <p>{text.comingSoon}</p>
  </div>
</BaseLayout>

<style>
  .coming-soon {
    padding-top: var(--space-12);
  }

  .coming-soon p {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

  @media (min-width: 40rem) {
    .coming-soon {
      padding-top: var(--space-16);
    }
  }
</style>
