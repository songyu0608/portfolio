---
// About(経歴): 페이지 머리 → 職歴 → 技術スタック → 資格. 배치 규칙은 docs/DESIGN.md §6.
// 콘텐츠 값은 src/content/(src/lib/content.ts로 조회), UI 문구는 src/i18n/ui.ts에서 가져온다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui, type Locale } from '../../i18n/ui';
import { getAboutContent } from '../../lib/content';
import CareerTimeline from '../CareerTimeline.astro';
import CertificationList from '../CertificationList.astro';
import SkillStack from '../SkillStack.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { name, description } = ui[locale].pages.about;
const text = ui[locale].about;
const { profile, career, skillCategories, certifications } =
  await getAboutContent(locale);
// 이력서 PDF는 파일이 있을 때만 콘텐츠에 쓴다. 없으면 링크 영역을 출력하지 않는다.
const resumes = profile.resumes ?? [];
---

<BaseLayout locale={locale} title={name} description={description}>
  <div class="about container">
    <section class="about-intro" aria-labelledby="about-title">
      <h1 id="about-title">{name}</h1>
      <p class="about-intro__profile">
        <span class="about-intro__name">{profile.name}</span>{' '}
        <span class="about-intro__role">{profile.role}</span>
      </p>
      {resumes.length > 0 && (
        <ul class="about-intro__resumes">
          {resumes.map((resume, index) => (
            <li>
              <a
                class:list={['button', { 'button--primary': index === 0 }]}
                href={resume.file}
                type="application/pdf"
              >
                <svg
                  class="about-intro__icon"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />
                </svg>
                {resume.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="about-section" aria-labelledby="about-career-title">
      <h2 id="about-career-title">{text.career.title}</h2>
      <div class="about-section__body">
        <CareerTimeline entries={career} />
      </div>
    </section>

    <section class="about-section" aria-labelledby="about-skills-title">
      <h2 id="about-skills-title">{text.skills.title}</h2>
      <p class="about-section__description">{ui[locale].skill.legend}</p>
      <div class="about-section__body">
        <SkillStack locale={locale} categories={skillCategories} />
      </div>
    </section>

    {certifications.length > 0 && (
      <section class="about-section" aria-labelledby="about-certs-title">
        <h2 id="about-certs-title">{text.certifications.title}</h2>
        <div class="about-section__body">
          <CertificationList locale={locale} certifications={certifications} />
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .about-intro {
    padding-top: var(--space-12);
  }

  .about-intro__profile {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .about-intro__name {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .about-intro__role {
    color: var(--color-text-muted);
  }

  .about-intro__resumes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .about-intro__icon {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .about-section {
    margin-top: var(--space-16);
  }

  .about-section__description {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  .about-section__body {
    margin-top: var(--space-6);
  }

  @media (min-width: 40rem) {
    .about-intro {
      padding-top: var(--space-16);
    }
  }
</style>
