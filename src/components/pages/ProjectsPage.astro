---
// Projects 목록: 페이지 머리 → 代表プロジェクト → その他のプロジェクト. 배치 규칙은 docs/DESIGN.md §7.
// 콘텐츠 값은 src/content/(src/lib/content.ts로 조회), UI 문구는 src/i18n/ui.ts에서 가져온다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui, type Locale } from '../../i18n/ui';
import { getProjectsContent } from '../../lib/content';
import ProjectCard from '../ProjectCard.astro';
import '../../styles/view-transitions.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { name, description } = ui[locale].pages.projects;
const text = ui[locale];
const { featured, others } = await getProjectsContent(locale);
---

<BaseLayout locale={locale} title={name} description={description}>
  <div class="projects container">
    <section class="projects-intro" aria-labelledby="projects-title">
      <h1 id="projects-title">{name}</h1>
      <p class="projects-intro__text">{text.projects.intro}</p>
    </section>

    <section class="projects-section" aria-labelledby="projects-featured-title">
      <h2 id="projects-featured-title">{text.project.featured}</h2>
      <ul
        class="project-grid projects-section__body"
        data-count={featured.length}
      >
        {featured.map((project) => (
          <li>
            <ProjectCard locale={locale} project={project} />
          </li>
        ))}
      </ul>
    </section>

    {others.length > 0 && (
      <section class="projects-section" aria-labelledby="projects-others-title">
        <h2 id="projects-others-title">{text.projects.others}</h2>
        <ul class="project-grid projects-section__body">
          {others.map((project) => (
            <li>
              <ProjectCard
                locale={locale}
                project={project}
                variant="compact"
              />
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .projects-intro {
    padding-top: var(--space-12);
  }

  .projects-intro__text {
    max-width: 40em;
    margin-top: var(--space-3);
    color: var(--color-text-muted);
  }

  .projects-section {
    margin-top: var(--space-16);
  }

  .projects-section__body {
    margin-top: var(--space-6);
  }

  @media (min-width: 40rem) {
    .projects-intro {
      padding-top: var(--space-16);
    }
  }
</style>
