---
// Home: 히어로 → 핵심 기술 → 대표 프로젝트. 배치 규칙은 docs/DESIGN.md §5.
// 콘텐츠 값은 src/content/(src/lib/content.ts로 조회), UI 문구는 src/i18n/ui.ts에서 가져온다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizePath } from '../../i18n/paths';
import { ui, type Locale } from '../../i18n/ui';
import { getHomeContent } from '../../lib/content';
import Phrases from '../Phrases.astro';
import ProjectCard from '../ProjectCard.astro';
import SkillTag from '../SkillTag.astro';
import '../../styles/view-transitions.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = ui[locale].home;
const { profile, skills, projects } = await getHomeContent(locale);
const projectsHref = localizePath(locale, 'projects');
const contactHref = localizePath(locale, 'contact');
---

<BaseLayout locale={locale} description={profile.description}>
  <div class="home container">
    <section class="hero" aria-labelledby="home-title">
      <h1 id="home-title" class="hero__name">
        {profile.name}
      </h1>
      <p class="hero__role">{profile.role}</p>
      <p class="hero__tagline" data-decode>
        <Phrases text={profile.tagline} />
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href={projectsHref}>
          {text.actions.projects}
        </a>
        <a class="button" href={contactHref}>
          {text.actions.contact}
        </a>
      </div>
    </section>

    <section class="home-section" aria-labelledby="home-skills-title">
      <h2 id="home-skills-title">{text.skills.title}</h2>
      <p class="home-section__description">{ui[locale].skill.legend}</p>
      <ul class="tag-list home-section__body">
        {skills.map((skill) => (
          <li>
            <SkillTag
              locale={locale}
              name={skill.name}
              primary={skill.primary}
            />
          </li>
        ))}
      </ul>
    </section>

    <section class="home-section" aria-labelledby="home-projects-title">
      <h2 id="home-projects-title">{ui[locale].project.featured}</h2>
      <ul class="project-grid home-section__body" data-count={projects.length}>
        {projects.map((project) => (
          <li>
            <ProjectCard locale={locale} project={project} />
          </li>
        ))}
      </ul>
      <a class="home-section__more" href={projectsHref}>
        {text.projects.all}
        <span aria-hidden="true">→</span>
      </a>
    </section>
  </div>
</BaseLayout>

<script>
  import '../../scripts/hero-decode';
</script>

<style>
  .hero {
    padding-top: var(--space-12);
  }

  .hero__role {
    margin-top: var(--space-3);
    color: var(--color-accent);
    font-size: var(--font-size-h3);
    font-weight: 700;
    line-height: var(--line-height-heading);
  }

  .hero__tagline {
    max-width: 34em;
    margin-top: var(--space-4);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.6;
  }

  /* 디코딩 중(src/scripts/hero-decode.ts): 최종 문구는 투명하게 두고 겹침 요소가 임의 글자를 그린다. */
  .hero__tagline.is-decoding {
    position: relative;
    color: transparent;
  }

  .hero__tagline :global(.decode-overlay) {
    display: block;
    position: absolute;
    inset: 0;
    overflow: hidden;
    color: var(--color-text);
    pointer-events: none;
    user-select: none;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .home-section {
    margin-top: var(--space-16);
  }

  .home-section__description {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  .home-section__body {
    margin-top: var(--space-6);
  }

  .home-section__more {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-4);
    font-weight: 700;
  }

  @media (min-width: 40rem) {
    .hero {
      padding-top: var(--space-16);
    }
  }
</style>
