---
// Contact: 페이지 머리 → 연락 수단 목록. 배치 규칙은 docs/DESIGN.md §8.
// 연락처 값은 src/content/contact.yaml(src/lib/content.ts로 조회), UI 문구는 src/i18n/ui.ts에서 가져온다.
// 연락 폼은 단계 8에서 이 목록 아래에 섹션으로 더한다(docs/PLAN.md §4).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui, type Locale } from '../../i18n/ui';
import { getContactContent } from '../../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { name, description } = ui[locale].pages.contact;
const text = ui[locale].contact;
const { intro, email, links } = await getContactContent(locale);
---

<BaseLayout locale={locale} title={name} description={description}>
  <div class="contact container">
    <section class="contact-intro" aria-labelledby="contact-title">
      <h1 id="contact-title">{name}</h1>
      <p class="contact-intro__text">{intro}</p>
    </section>

    <section class="contact-methods" aria-labelledby="contact-methods-title">
      <h2 id="contact-methods-title" class="sr-only">
        {text.methods}
      </h2>
      <ul class="contact-list">
        <li class="contact-item">
          <span class="contact-item__label">{text.method.email}</span>
          <p class="contact-item__value">
            <a href={`mailto:${email.address}`}>{email.address}</a>
            {email.placeholder && (
              <span class="contact-item__placeholder">{text.placeholder}</span>
            )}
          </p>
          <!--
            JS가 없거나 클립보드를 쓸 수 없으면 hidden 그대로 둔다(아래 스크립트가 켬).
            상태(data-state)에 따라 아이콘이 바뀌고, 결과는 role="status" 영역으로도 알린다.
          -->
          <button
            type="button"
            class="copy-button"
            hidden
            aria-label={text.copy.name}
            data-copy={email.address}
            data-label={text.copy.label}
            data-done={text.copy.done}
            data-failed={text.copy.failed}
          >
            <svg
              class="copy-button__icon copy-button__icon--copy"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              aria-hidden="true"
              focusable="false"
            >
              <rect x="9" y="9" width="12" height="12" rx="2"></rect>
              <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
            </svg>
            <svg
              class="copy-button__icon copy-button__icon--done"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M5 12.5 10 17.5 19 7"></path>
            </svg>
            <span class="copy-button__text">{text.copy.label}</span>
          </button>
          <span class="sr-only" role="status" data-copy-status></span>
        </li>
        {links.map((link) => (
          <li class="contact-item">
            <span class="contact-item__label">{text.method[link.id]}</span>
            <p class="contact-item__value">
              <a href={link.url}>{link.display}</a>
              {link.placeholder && (
                <span class="contact-item__placeholder">
                  {text.placeholder}
                </span>
              )}
            </p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<script>
  // 메일 주소 복사. 클립보드 API를 쓸 수 있을 때만 버튼을 보인다(점진적 향상).
  const RESET_MS = 2000;
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    '.copy-button[data-copy]',
  );

  if (navigator.clipboard && window.isSecureContext) {
    buttons.forEach((button) => {
      const text = button.querySelector('.copy-button__text');
      const status = button.parentElement?.querySelector('[data-copy-status]');
      let timer: number | undefined;

      const show = (state: 'idle' | 'done' | 'failed') => {
        const message =
          state === 'idle' ? button.dataset.label : button.dataset[state];
        button.dataset.state = state;
        if (text) text.textContent = message ?? '';
        // 같은 문구를 연달아 알릴 수 있게 비운 뒤 넣는다.
        if (status)
          status.textContent = state === 'idle' ? '' : (message ?? '');
      };

      button.hidden = false;
      button.addEventListener('click', async () => {
        window.clearTimeout(timer);
        if (status) status.textContent = '';
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? '');
          show('done');
        } catch {
          show('failed');
        }
        timer = window.setTimeout(() => show('idle'), RESET_MS);
      });
    });
  }
</script>

<style>
  .contact-intro {
    padding-top: var(--space-12);
  }

  .contact-intro__text {
    max-width: 40em;
    margin-top: var(--space-3);
    color: var(--color-text-muted);
  }

  .contact-methods {
    max-width: 46em;
    margin-top: var(--space-8);
  }

  .contact-list {
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    list-style: none;
  }

  .contact-item {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    padding: var(--space-4);
  }

  .contact-item + .contact-item {
    border-top: 1px solid var(--color-border);
  }

  .contact-item__label {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .contact-item__value {
    min-width: 0;
    max-width: 100%;
    font-family: var(--font-mono);
    font-size: 1rem;
    overflow-wrap: anywhere;
  }

  .contact-item__placeholder {
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--font-size-small);
  }

  .copy-button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: var(--space-2);
    padding: 0 var(--space-4);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--color-accent);
    font: inherit;
    font-size: var(--font-size-small);
    font-weight: 700;
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  .copy-button[hidden] {
    display: none;
  }

  .copy-button:hover {
    background: var(--color-background);
  }

  .copy-button__icon {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .copy-button__icon--done,
  .copy-button[data-state='done'] .copy-button__icon--copy {
    display: none;
  }

  .copy-button[data-state='done'] .copy-button__icon--done {
    display: block;
  }

  @media (min-width: 40rem) {
    .contact-intro {
      padding-top: var(--space-16);
    }

    .contact-item {
      grid-template-columns: 9rem minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-4);
      padding: var(--space-4) var(--space-6);
    }

    .contact-item__value {
      font-size: 1.125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .copy-button {
      transition: none;
    }
  }
</style>
