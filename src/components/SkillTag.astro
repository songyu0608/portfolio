---
// 기술 태그. 주력 기술은 채운 태그와 시각적으로 숨긴 「主軸」 텍스트로 구분한다.
// 링크·버튼이 아니므로 클릭 동작이 없다. Home 핵심 기술, 프로젝트 카드, About 기술 스택(T05)이 쓴다.
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  name: string;
  primary?: boolean;
}

const { locale, name, primary = false } = Astro.props;
---

<span class:list={['tag', { 'tag--featured': primary }]}>
  {primary && <span class="sr-only">{ui[locale].skill.primary}</span>}
  {name}
</span>
