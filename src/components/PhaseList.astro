---
// 担当工程. 다섯 공정을 고정 순서(PHASES)로 모두 보여 주고, 맡은 공정은 채운 칸 + 체크,
// 맡지 않은 공정은 점선 칸으로 구분한다. 색·모양에 더해 칸마다 시각적으로 숨긴 상태 텍스트를 둔다.
// 프로젝트 카드(size="card")와 상세 개요(size="detail")가 쓴다. 배치 규칙은 docs/DESIGN.md §7.
import { PHASES } from '../content.config';
import { ui, type Locale } from '../i18n/ui';
import type { Phase } from '../lib/content';

interface Props {
  locale: Locale;
  /** 맡은 공정 */
  phases: Phase[];
  size?: 'card' | 'detail';
}

const { locale, phases, size = 'card' } = Astro.props;
const text = ui[locale].project;
---

<ol class:list={['phase-list', `phase-list--${size}`]}>
  {PHASES.map((phase) => {
    const handled = phases.includes(phase);
    return (
      <li class:list={['phase', { 'phase--handled': handled }]}>
        {handled && (
          <svg
            class="phase__check"
            viewBox="0 0 12 12"
            width="12"
            height="12"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M2 6.5l2.5 2.5L10 3.5" />
          </svg>
        )}
        {text.phase[phase]}
        <span class="sr-only">
          {handled ? text.phaseState.on : text.phaseState.off}
        </span>
      </li>
    );
  })}
</ol>

<style>
  .phase-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .phase {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    padding: 0.125rem var(--space-2);
    border: 1px dashed var(--color-text-muted);
    border-radius: var(--radius-button);
    color: var(--color-text-muted);
    font-size: var(--font-size-label);
    line-height: 1.5;
  }

  .phase--handled {
    border-style: solid;
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 700;
  }

  .phase__check {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .phase-list--detail {
    gap: var(--space-2);
  }

  .phase-list--detail .phase {
    padding: var(--space-2) var(--space-3);
    font-size: var(--font-size-small);
  }

  .phase-list--detail .phase__check {
    width: 14px;
    height: 14px;
  }

  @media (min-width: 40rem) {
    .phase-list--detail {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .phase-list--detail .phase {
      padding-inline: var(--space-1);
    }
  }
</style>
