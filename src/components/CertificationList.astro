---
// 자격증 목록. 시안 A「シンプルリスト」(docs/CONTENT.md "자격증 표기 규칙"): 왼쪽 취득 연월, 오른쪽 이름.
// 학습 중 행은 왼쪽에 「学習中」 라벨, 오른쪽에 UI 문구 템플릿으로 만든 「〇〇 取得に向けて学習中」을 둔다.
import { ui, type Locale } from '../i18n/ui';
import type { LocalizedCertification } from '../lib/content';

interface Props {
  locale: Locale;
  certifications: LocalizedCertification[];
}

const { locale, certifications } = Astro.props;
const text = ui[locale].about.certifications;
---

<dl class="certifications">
  {certifications.map((certification) =>
    certification.status === 'studying' ? (
      <div class="certifications__row">
        <dt class="certifications__studying">{text.studying}</dt>
        <dd>{text.studyingName.replace('{name}', certification.name)}</dd>
      </div>
    ) : (
      <div class="certifications__row">
        <dt class="certifications__date">{certification.acquired}</dt>
        <dd>{certification.name}</dd>
      </div>
    ),
  )}
</dl>

<style>
  .certifications {
    max-width: 48rem;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }

  .certifications__row {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    align-items: baseline;
    column-gap: var(--space-6);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .certifications__row dd {
    margin: 0;
  }

  .certifications__date {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-small);
  }

  .certifications__studying {
    color: var(--color-accent);
    font-size: var(--font-size-small);
    font-weight: 700;
  }
</style>
