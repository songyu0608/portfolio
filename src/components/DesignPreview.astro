---
// BaseLayout의 <main> 안에 들어가는 본문 컴포넌트. 랜드마크(main, footer)를 만들지 않는다.
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = ui[locale].design;
const swatches = [
  { key: 'background', label: d.swatchBackground },
  { key: 'surface', label: d.swatchSurface },
  { key: 'accent', label: d.swatchAccent },
  { key: 'text', label: d.swatchText },
  { key: 'muted', label: d.swatchMuted },
] as const;
---

<div class="preview container">
  <header class="preview__hero">
    <div class="preview__eyebrow-row">
      <p class="preview__eyebrow">{d.eyebrow}</p>
      <span class="preview__label">{d.label}</span>
    </div>
    <div class="preview__hero-copy">
      <h1>{d.heading}</h1>
      <p class="preview__lead measure">{d.introduction}</p>
      <div class="preview__actions">
        <a class="button button--primary" href="#typography">
          {d.primaryAction} <span aria-hidden="true">↓</span>
        </a>
        <a class="button" href="#palette">
          {d.secondaryAction}
        </a>
      </div>
    </div>
  </header>

  <section
    id="palette"
    class="preview__section"
    aria-labelledby="palette-heading"
  >
    <div class="preview__section-heading">
      <div>
        <p class="preview__section-number">01 / COLOR</p>
        <h2 id="palette-heading">{d.paletteTitle}</h2>
      </div>
      <p class="preview__section-description">{d.paletteDescription}</p>
    </div>
    <ul class="preview__swatches">
      {swatches.map((swatch) => (
        <li class="preview__swatch">
          <span
            class:list={[
              'preview__swatch-color',
              `preview__swatch-color--${swatch.key}`,
            ]}
            aria-hidden="true"
          ></span>
          <span class="preview__swatch-label">{swatch.label}</span>
          <code>{`--color-${swatch.key === 'muted' ? 'text-muted' : swatch.key}`}</code>
        </li>
      ))}
    </ul>
  </section>

  <div class="preview__details">
    <section
      id="typography"
      class="preview__section preview__panel"
      aria-labelledby="typography-heading"
    >
      <p class="preview__section-number">02 / TYPE</p>
      <h2 id="typography-heading">{d.typographyTitle}</h2>
      <p class="preview__section-description">{d.typographyDescription}</p>
      <p class="preview__type-sample">{d.typographySample}</p>
      <p class="preview__body-sample">{d.bodySample}</p>
      <p class="preview__mono-sample">{d.monoSample}</p>
    </section>

    <section
      id="samples"
      class="preview__section preview__panel"
      aria-labelledby="components-heading"
    >
      <p class="preview__section-number">03 / UI</p>
      <h2 id="components-heading">{d.componentsTitle}</h2>
      <p class="preview__section-description">{d.componentsDescription}</p>
      <a class="preview__sample-link" href="#palette">
        {d.textLink} <span aria-hidden="true">↑</span>
      </a>
      <ul class="preview__tags" aria-label={d.featuredExplanation}>
        <li>
          <span class="tag">{d.defaultTag}</span>
        </li>
        <li>
          <span class="tag tag--featured">
            <span class="sr-only">{d.featuredA11y} </span>
            {d.featuredTag}
          </span>
        </li>
      </ul>
      <p class="preview__hint">{d.featuredExplanation}</p>
      <ul class="preview__statuses">
        <li class="preview__status preview__status--success">{d.success}</li>
        <li class="preview__status preview__status--warning">{d.warning}</li>
        <li class="preview__status preview__status--error">{d.error}</li>
      </ul>
    </section>
  </div>

  <article
    class="preview__section card preview__example-card"
    aria-labelledby="card-heading"
  >
    <p class="preview__section-number">04 / SURFACE</p>
    <h2 id="card-heading">{d.cardTitle}</h2>
    <p class="measure">{d.cardBody}</p>
  </article>

  <div class="preview__note">
    <p>{d.note}</p>
    <span class="preview__note-mark" aria-hidden="true">
      {' '}
      CH / 02{' '}
    </span>
  </div>
</div>

<style>
  .preview {
    padding-top: var(--space-6);
  }

  .preview__hero {
    position: relative;
    min-height: 360px;
    padding: var(--space-6);
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .preview__hero::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--color-accent);
    content: '';
  }

  .preview__eyebrow-row,
  .preview__section-heading,
  .preview__note {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .preview__eyebrow,
  .preview__section-number,
  .preview__mono-sample,
  .preview__note-mark {
    font-family: var(--font-mono);
    font-size: var(--font-size-label);
    letter-spacing: 0.08em;
  }

  .preview__eyebrow,
  .preview__section-number {
    color: var(--color-accent);
    font-weight: 700;
  }

  .preview__label,
  .preview__section-description,
  .preview__hint,
  .preview__note {
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  .preview__hero-copy {
    position: relative;
    z-index: 1;
    max-width: 680px;
    padding-block: var(--space-16) var(--space-4);
  }

  .preview__hero-copy h1 {
    max-width: 14ch;
  }

  .preview__lead {
    margin-top: var(--space-6);
    color: var(--color-text-muted);
  }

  .preview__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .preview__section {
    margin-top: var(--space-16);
  }

  .preview__section-heading {
    margin-bottom: var(--space-6);
  }

  .preview__section-heading h2,
  .preview__panel h2 {
    margin-top: var(--space-2);
  }

  .preview__section-description {
    max-width: 38ch;
  }

  .preview__swatches {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .preview__swatch {
    min-width: 0;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .preview__swatch-color {
    display: block;
    height: 72px;
    margin-bottom: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius-card) - 4px);
  }

  .preview__swatch-color--background {
    background: var(--color-background);
  }

  .preview__swatch-color--surface {
    background: var(--color-surface);
  }

  .preview__swatch-color--accent {
    background: var(--color-accent);
  }

  .preview__swatch-color--text {
    background: var(--color-text);
  }

  .preview__swatch-color--muted {
    background: var(--color-text-muted);
  }

  .preview__swatch-label {
    display: block;
    font-weight: 700;
  }

  .preview__swatch code {
    display: block;
    overflow: hidden;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-label);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .preview__details {
    display: grid;
    gap: var(--space-6);
  }

  .preview__panel {
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .preview__panel .preview__section-description {
    margin-top: var(--space-3);
  }

  .preview__type-sample {
    margin-top: var(--space-8);
    font-size: clamp(1.75rem, 1.5rem + 1.5vw, 2.5rem);
    font-weight: 700;
    line-height: 1.35;
  }

  .preview__body-sample {
    max-width: 48ch;
    margin-top: var(--space-4);
  }

  .preview__mono-sample {
    margin-top: var(--space-6);
    color: var(--color-text-muted);
  }

  .preview__sample-link {
    display: inline-block;
    margin-top: var(--space-8);
  }

  .preview__tags,
  .preview__statuses {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .preview__tags {
    margin: var(--space-6) 0 var(--space-2);
  }

  .preview__hint {
    margin-top: var(--space-2);
  }

  .preview__statuses {
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .preview__status {
    font-size: var(--font-size-small);
    font-weight: 700;
  }

  .preview__status::before {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: var(--space-2);
    border-radius: 50%;
    background: currentColor;
    content: '';
    vertical-align: middle;
  }

  .preview__status--success {
    color: var(--color-success);
  }

  .preview__status--warning {
    color: var(--color-warning);
  }

  .preview__status--error {
    color: var(--color-error);
  }

  .preview__example-card {
    max-width: 680px;
  }

  .preview__example-card h2 {
    margin-top: var(--space-2);
  }

  .preview__example-card p:last-child {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

  .preview__note {
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .preview__note p {
    max-width: 66ch;
  }

  @media (min-width: 40rem) {
    .preview {
      padding-top: var(--space-12);
    }

    .preview__hero {
      min-height: 420px;
      padding: var(--space-8);
    }

    .preview__swatches {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .preview__details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .preview {
      padding-top: var(--space-16);
    }

    .preview__hero {
      padding: var(--space-12);
    }

    .preview__swatches {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
