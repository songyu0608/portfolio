---
// 명령 팔레트(T10)를 여는 헤더 버튼. ⌘K / Ctrl+K도 같은 동작이다(src/scripts/command-launcher.ts,
// SiteHeader.astro의 스크립트가 불러온다).
// JS가 없으면 동작하지 않으므로 테마 버튼처럼 html.js일 때만 보인다.
// 데이터 URL과 같은 페이지의 다른 언어 URL은 서버에서 계산해 data-*로 넘긴다(클라이언트는 경로 규칙을 모른다).
import { localizePath, switchLocalePath } from '../i18n/paths';
import { locales, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const alternate = locales.find((code) => code !== locale) ?? locale;
const dataSrc = `${localizePath(locale, 'home')}commands.json`;
const alternateHref = switchLocalePath(Astro.url.pathname, alternate);
---

<button
  type="button"
  class="command-button"
  aria-label={ui[locale].command.open}
  aria-keyshortcuts="Meta+K Control+K"
  data-command-palette
  data-src={dataSrc}
  data-alternate={alternateHref}
>
  <svg
    viewBox="0 0 24 24"
    width="20"
    height="20"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="11" cy="11" r="7"></circle>
    <path d="M20 20l-3.5-3.5"></path>
  </svg>
</button>

<style>
  .command-button {
    display: none;
    width: 44px;
    height: 44px;
    flex: none;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--color-text-muted);
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  :global(html.js) .command-button {
    display: inline-flex;
  }

  .command-button:hover {
    background: var(--color-surface);
  }

  .command-button svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .command-button {
      transition: none;
    }
  }
</style>
