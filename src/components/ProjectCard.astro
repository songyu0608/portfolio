---
// 프로젝트 카드. 제목·요약·기간·역할·성과·기술을 모두 펼쳐 보인다(정보를 숨기는 효과 금지).
// 상세 페이지가 생기면 카드 전체를 링크로 바꾼다(단계 5 컨셉 2, Projects 지시서).
import { ui, type Locale } from '../i18n/ui';
import type { Project } from '../lib/content';
import Phrases from './Phrases.astro';
import SkillTag from './SkillTag.astro';

interface Props {
  locale: Locale;
  project: Project;
}

const { locale, project } = Astro.props;
const text = ui[locale].project;
---

<article class="project-card card">
  <h3 class="project-card__title">
    <Phrases text={project.title} />
  </h3>
  <p class="project-card__summary">{project.summary}</p>
  <dl class="project-card__facts">
    <div>
      <dt>{text.period}</dt>
      <dd class="project-card__period">{project.period}</dd>
    </div>
    <div>
      <dt>{text.role}</dt>
      <dd>{project.role}</dd>
    </div>
    <div>
      <dt>{text.highlights}</dt>
      <dd>
        <ul class="project-card__highlights">
          {project.highlights.map((highlight) => (
            <li>{highlight}</li>
          ))}
        </ul>
      </dd>
    </div>
    <div>
      <dt>{text.tech}</dt>
      <dd>
        <ul class="tag-list">
          {project.tech.map((name) => (
            <li>
              <SkillTag locale={locale} name={name} />
            </li>
          ))}
        </ul>
      </dd>
    </div>
  </dl>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .project-card__summary {
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  .project-card__facts {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: var(--font-size-small);
  }

  .project-card__facts dt {
    color: var(--color-text-muted);
    font-size: var(--font-size-label);
    font-weight: 700;
  }

  .project-card__facts dd {
    margin: var(--space-1) 0 0;
  }

  .project-card__period {
    font-family: var(--font-mono);
  }

  .project-card__highlights {
    margin: 0;
    padding-left: 1.25em;
    font-weight: 700;
  }

  .project-card__highlights li::marker {
    color: var(--color-accent);
  }
</style>
