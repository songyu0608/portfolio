---
// 프로젝트 카드. 카드 전체가 상세 페이지 링크다(docs/DESIGN.md §3 컨셉 2, 틸트·전환 애니메이션은 단계 5).
// 링크는 제목 안의 <a> 하나이고, ::after를 카드 전체로 늘려 어디를 눌러도 상세로 간다.
// 카드 전체를 <a>로 감싸면 링크 이름이 카드 전문이 되어 길어지기 때문이다.
// 정보는 모두 펼쳐 보인다(정보를 숨기는 효과 금지). 정보 순서는 期間 → 担当工程 → 役割 → 成果 → 技術.
// compact는 Projects의 「その他」 카드로, 成果를 빼고 期間·役割 → 担当工程 → 技術 순서다.
import { localizeProjectPath } from '../i18n/paths';
import { ui, type Locale } from '../i18n/ui';
import type { Project } from '../lib/content';
import PhaseList from './PhaseList.astro';
import Phrases from './Phrases.astro';
import SkillTag from './SkillTag.astro';

interface Props {
  locale: Locale;
  project: Project;
  variant?: 'full' | 'compact';
}

const { locale, project, variant = 'full' } = Astro.props;
const text = ui[locale].project;
const href = localizeProjectPath(locale, project.slug);
---

<article class:list={['project-card card', `project-card--${variant}`]}>
  <h3 class="project-card__title">
    <a class="project-card__link" href={href}>
      <Phrases text={project.title} />
    </a>
  </h3>
  <p class="project-card__summary">{project.summary}</p>
  <dl class="project-card__facts">
    <div>
      <dt>{text.period}</dt>
      <dd class="project-card__period">{project.period}</dd>
    </div>
    {variant === 'compact' && (
      <div>
        <dt>{text.role}</dt>
        <dd>{project.role}</dd>
      </div>
    )}
    <div class="project-card__fact--wide">
      <dt>{text.phases}</dt>
      <dd>
        <PhaseList locale={locale} phases={project.phases} />
      </dd>
    </div>
    {variant === 'full' && (
      <>
        <div>
          <dt>{text.role}</dt>
          <dd>{project.role}</dd>
        </div>
        <div>
          <dt>{text.highlights}</dt>
          <dd>
            <ul class="project-card__highlights">
              {project.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          </dd>
        </div>
      </>
    )}
    <div class="project-card__fact--wide">
      <dt>{text.tech}</dt>
      <dd>
        <ul class="tag-list">
          {project.tech.map((name) => (
            <li>
              <SkillTag locale={locale} name={name} />
            </li>
          ))}
        </ul>
      </dd>
    </div>
  </dl>
  <p class="project-card__more" aria-hidden="true">
    {text.more} →
  </p>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: border-color var(--duration-base) var(--ease-standard);
  }

  .project-card:hover {
    border-color: var(--color-accent);
  }

  .project-card__link {
    color: inherit;
    text-decoration: none;
  }

  /* 카드 전체를 누를 수 있게 링크 영역을 카드 크기로 늘린다. */
  .project-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
  }

  /* 포커스 링은 링크 글자가 아니라 카드 전체에 그린다. */
  .project-card__link:focus-visible {
    outline: none;
  }

  .project-card__link:focus-visible::after {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .project-card:hover .project-card__link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .project-card__summary {
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  .project-card__facts {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: var(--font-size-small);
  }

  .project-card__facts dt {
    color: var(--color-text-muted);
    font-size: var(--font-size-label);
    font-weight: 700;
  }

  .project-card__facts dd {
    margin: var(--space-1) 0 0;
  }

  .project-card__period {
    font-family: var(--font-mono);
  }

  .project-card__highlights {
    margin: 0;
    padding-left: 1.25em;
    font-weight: 700;
  }

  .project-card__highlights li::marker {
    color: var(--color-accent);
  }

  .project-card__more {
    margin-top: auto;
    padding-top: var(--space-2);
    color: var(--color-accent);
    font-size: var(--font-size-small);
    font-weight: 700;
  }

  /* 짧은 카드: 期間·役割 → 担当工程 → 技術. 640px 이상에서 期間·役割를 한 줄 2칸에 둔다. */
  @media (min-width: 40rem) {
    .project-card--compact .project-card__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }

    .project-card--compact .project-card__fact--wide {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }
  }
</style>
