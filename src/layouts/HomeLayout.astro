---
// Home 페이지 진입점(라우트 src/pages/{ja,en}/index.astro가 언어만 넘긴다). 콘텐츠를 조회해 React 화면
// (src/components/pages/HomePage.tsx)에 넘기고, 이 페이지에만 필요한 스크립트를 넣는다. 마크업·스타일은 두지 않는다.
import type { Locale } from '../i18n/ui';
import { getHomeContent } from '../lib/content';
// BaseLayout(전역 CSS)을 화면 컴포넌트보다 먼저 import한다. CSS가 import 순서대로 놓이므로, 이 순서여야
// 같은 명시도에서 컴포넌트 CSS Modules 규칙이 전역 클래스(.tag-list 등)를 이긴다.
import BaseLayout from './BaseLayout.astro';
import HomePage from '../components/pages/HomePage';
import CardTiltScript from './scripts/CardTiltScript.astro';
import '../styles/view-transitions.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = await getHomeContent(locale);
---

<BaseLayout locale={locale} description={content.profile.description}>
  <HomePage locale={locale} {...content} />
  <CardTiltScript />
</BaseLayout>

<script>
  import '../scripts/hero-decode';
</script>
