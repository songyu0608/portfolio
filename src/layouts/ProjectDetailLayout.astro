---
// 프로젝트 상세 페이지 진입점(라우트 src/pages/{ja,en}/projects/[slug].astro가 getStaticPaths의 props를 넘긴다).
// React 화면(src/components/pages/ProjectDetailPage.tsx)을 그린다. 페이지 전용 스크립트는 없다.
import type { Locale } from '../i18n/ui';
import type { ProjectPage } from '../lib/content';
// BaseLayout(전역 CSS)을 화면 컴포넌트보다 먼저 import한다. CSS가 import 순서대로 놓이므로, 이 순서여야
// 같은 명시도에서 컴포넌트 CSS Modules 규칙이 전역 클래스(.tag-list 등)를 이긴다.
import BaseLayout from './BaseLayout.astro';
import ProjectDetailPage from '../components/pages/ProjectDetailPage';
import '../styles/view-transitions.css';

type Props = ProjectPage & { locale: Locale };

const { locale, project, prev, next } = Astro.props;
// <title>은 문절 배열이면 이어 붙인 문자열을 쓴다.
const title =
  typeof project.title === 'string' ? project.title : project.title.join('');
---

<BaseLayout locale={locale} title={title} description={project.summary}>
  <ProjectDetailPage
    locale={locale}
    project={project}
    prev={prev}
    next={next}
  />
</BaseLayout>
