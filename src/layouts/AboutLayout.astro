---
// About 페이지 진입점(라우트 src/pages/{ja,en}/about.astro가 언어만 넘긴다). 콘텐츠를 조회해
// React 화면(src/components/pages/AboutPage.tsx)에 넘긴다. 페이지 전용 스크립트는 없다(경력 타임라인은 CSS만).
import { ui, type Locale } from '../i18n/ui';
import { getAboutContent } from '../lib/content';
// BaseLayout(전역 CSS)을 화면 컴포넌트보다 먼저 import한다. CSS가 import 순서대로 놓이므로, 이 순서여야
// 같은 명시도에서 컴포넌트 CSS Modules 규칙이 전역 클래스(.tag-list 등)를 이긴다.
import BaseLayout from './BaseLayout.astro';
import AboutPage from '../components/pages/AboutPage';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { name, description } = ui[locale].pages.about;
const content = await getAboutContent(locale);
---

<BaseLayout locale={locale} title={name} description={description}>
  <AboutPage locale={locale} {...content} />
</BaseLayout>
