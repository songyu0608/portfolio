---
import { ui } from '../../i18n/ui';
const text = ui.en;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={text.description} />
    <title>{text.title}</title>
  </head>
  <body>
    <main>
      <h1>{text.heading}</h1>
      <p>{text.description}</p>
    </main>
  </body>
</html>
