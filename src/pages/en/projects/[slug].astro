---
// 프로젝트 상세. 프로젝트마다 /en/projects/<slug>/ 페이지를 만든다.
import ProjectDetailLayout from '../../../layouts/ProjectDetailLayout.astro';
import { getProjectPages, type ProjectPage } from '../../../lib/content';

export async function getStaticPaths() {
  const pages = await getProjectPages('en');
  return pages.map((page) => ({
    params: { slug: page.project.slug },
    props: page,
  }));
}

type Props = ProjectPage;

const page = Astro.props;
---

<ProjectDetailLayout locale="en" {...page} />
